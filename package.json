{
  "name": "circulos-einstein",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser-adjustment.cjs",
    "build:web": "bash scripts/fetch-ocr-model.sh && tsc --noEmit && vite build --config vite.browser.config.ts && node scripts/inline-browser.mjs",
    "test:web": "node tests/browser-adjustment.cjs"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.1",
    "concurrently": "^9.2.1",
    "playwright": "1.62.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vite-plugin-singlefile": "^2.3.0"
  },
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
